# Database Connection Strings
# Server A1 - MyLocalData
DB_A1_SERVER=A1
DB_A1_DATABASE=MyLocalData
DB_A1_TRUSTED=yes

# Server B2 - Multiple Databases
DB_B2_SERVER=B2
DB_B2_TEMPDB=TempDB
DB_B2_GENESYSDB=GenesysDB
DB_B2_TRUSTED=yes

# Query Timeouts (seconds)
SQL_QUERY_TIMEOUT=300
SQL_BULK_TIMEOUT=600

# Cache Settings
CACHE_TYPE=filesystem  # Options: filesystem, redis
CACHE_DIR=cache
CACHE_DEFAULT_TIMEOUT=3600

# Redis Settings (if using Redis cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Application Settings
DEBUG=False
HOST=0.0.0.0
PORT=8000
